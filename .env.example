# Base Immich URL. /api is added automatically if omitted.
IMMICH_URL=https://photos.example.com
IMMICH_API_KEY=replace-me

# The long-running Docker service stays in report mode.
# Use docker compose run --rm -e MODE=apply ... for a one-shot execute.
MODE=report

# 3600 = scan hourly. Set to 0 for one report scan then exit.
SCAN_INTERVAL_SECONDS=3600
IMMICH_TIMEOUT_SECONDS=30

# Apply mode processes every live SAFE_HEIC_CANDIDATE, in internal batches.
APPLY_BATCH_SIZE=100
